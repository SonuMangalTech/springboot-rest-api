<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>3.5.4</version>
		<relativePath/> <!-- lookup parent from repository -->
	</parent>
	<groupId>com.sonumangal.tech</groupId>
	<artifactId>springboot-rest-api</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name>springboot-rest-api</name>
	<description>This repo contains rest api using different methods</description>
	<packaging>war</packaging>

	<properties>
		<java.version>17</java.version>
		<bucket4j.version>8.19.0</bucket4j.version>
	</properties>

	<developers>
		<developer>
			<id>SonuMangalTech</id>
			<name>Sonu Mangal</name>
			<email>sonumangal.tech@gmail.com</email>
			<url>https://www.linkedin.com/in/sonu-mangal/</url>
			<roles>
				<role>AI and Tech Content Creator</role>
			</roles>
			<timezone>UTC +5:30</timezone>
		</developer>
	</developers>


	<dependencies>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-web</artifactId>
		</dependency>

		<dependency>
			<groupId>org.projectlombok</groupId>
			<artifactId>lombok</artifactId>
			<optional>true</optional>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>
		</plugins>
	</build>

</project>
